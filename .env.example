# Variables de entorno de LEVITA. Nunca poner valores reales en este archivo.
# Ver docs/16-arquitectura-multitenant.md §17 y docs/adr/0011-observabilidad.md.

# --- Supabase --------------------------------------------------------------
# Públicas (prefijo NEXT_PUBLIC_): accesibles desde el navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NUNCA en NEXT_PUBLIC_, nunca en el navegador, nunca en una
# ruta que reciba un churchId del cliente. Se salta RLS por completo.
SUPABASE_SERVICE_ROLE_KEY=

# --- Aplicación --------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Avisos (Fase 5) ---------------------------------------------------------
# Secreto de la tarea programada POST /api/tareas/avisos. Sin él, la ruta
# responde 503 y no procesa nada.
CRON_SECRET=
# Transporte externo de avisos: "disabled" (por defecto) deja las entregas de
# email y push en cola, sin contactar con ningún proveedor. La bandeja dentro
# de la aplicación funciona igualmente.
NOTIFICATIONS_TRANSPORT=disabled

# --- Observabilidad (opcional, fase posterior) ------------------------------
# LOG_LEVEL=info
